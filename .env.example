# ── GitHub ────────────────────────────────────────────────────────────────────
# Fine-grained PAT with read:user, read:org, read:project scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your GitHub username (used to restrict admin login)
GITHUB_USERNAME=yourname
# Secret for validating incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Auth.js (GitHub OAuth) ────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
AUTH_GITHUB_ID=Iv1.xxxxxxxxxxxx
AUTH_GITHUB_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Generate with: openssl rand -base64 32
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vercel KV (Upstash Redis) ─────────────────────────────────────────────────
# Available in Vercel dashboard → Storage → KV database → .env.local
KV_REST_API_URL=https://xxxxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public (exposed to browser) ───────────────────────────────────────────────
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Formspree endpoint for the contact form
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/xxxxxxxx
